# ============================================================================
# Mamômetro CS — variáveis de ambiente (copie para .env e preencha)
# ============================================================================

# ===== Firebase (config web — vai pro navegador, é público por natureza) =====
# A proteção real são as regras do Realtime Database, não estas chaves.
# O SPA lê estas VITE_* no build; o server.js também lê a VITE_FIREBASE_* em
# runtime pra injetar no public/onboard.html (página standalone).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ===== Admins (organizadores) =====
# SteamIDs que podem abrir o painel do organizador, separados por vírgula.
# O admin entra com a Steam (como qualquer jogador) e ganha o botão "Organizador".
# Ex.: VITE_ADMIN_STEAMIDS=765611...,765611...
VITE_ADMIN_STEAMIDS=

# ===== Steam Web API (SÓ no servidor — sem prefixo VITE_) =====
# Pegue uma chave em https://steamcommunity.com/dev/apikey
# Usada por: /api/steam-profile, /api/onboard e o roster-sync.
STEAM_API_KEY=

# ===== GSI (kills/dano automático do CS2) =====
# Token compartilhado: MESMO valor nos dois (a função valida, o cliente exibe).
GSI_TOKEN=mamometro-gsi
VITE_GSI_TOKEN=mamometro-gsi

# ===== URL pública do site =====
# O .cfg do GSI aponta pra ela (não use localhost). Self-hosted na infra própria.
VITE_SITE_URL=https://seu-site.com

# ===== Firebase Realtime Database — lado servidor =====
# MESMO valor de VITE_FIREBASE_DATABASE_URL acima (a var VITE_ é pro SPA; esta,
# sem prefixo, é lida server-side pelas functions /api/* e pelos serviços Python).
# Definida UMA vez aqui; o docker-compose repassa pros containers do pipeline.
FIREBASE_DATABASE_URL=

# ============================================================================
# Pipeline de demos (VPS) — bot que baixa e parseia as partidas
# ============================================================================

# Conta descartável do bot do cs-demo-downloader. NUNCA commite valores reais.
# O roster-sync as lê pra regenerar o config.json do downloader.
# ATENÇÃO ao rename na fronteira do compose: estas STEAM_BOT_* são mapeadas pra
# BOT_USERNAME/BOT_PASSWORD/BOT_SHARED_SECRET dentro do container roster-sync.
STEAM_BOT_USERNAME=REPLACE
STEAM_BOT_PASSWORD=REPLACE
STEAM_BOT_SHARED_SECRET=REPLACE_shared_secret_base64

# Mínimo de jogadores do grupo (roster + estado/players) presentes numa demo
# pra ela ser salva. Abaixo disso descarta (e discardedByFilter++ no RTDB).
GROUP_MIN_MEMBERS=3

# ---- Vars abaixo NÃO ficam no .env: são setadas direto no docker-compose.yml,
# ---- com defaults no código. Listadas aqui só como referência do que existe.
#
#   Firebase Admin (server-side, todos os serviços Python + as functions):
#     FIREBASE_SA_PATH=/secrets/firebase-admin.json   # service-account (montado)
#
#   demo-parser:
#     DEMOS_DIR=/demos               ROSTER_PATH=/config/roster.json
#     POLL_INTERVAL_SEC=30           DELETE_AFTER_PROCESS=true
#     FILE_STABILITY_SEC=5           TEMP_CLEANUP_SEC=3600
#
#   roster-sync:
#     CONFIG_OUTPUT_PATH=/config/config.json   POLL_INTERVAL_SEC=60
#
#   watchdog:
#     CHECK_SEC=600   STALE_MIN=45   CRON_WINDOW=17-23   CONTAINER_NAME=mamometro-downloader
