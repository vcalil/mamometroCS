# ===== Firebase (config web — vai pro navegador, é público por natureza) =====
# A proteção real são as regras do Realtime Database, não estas chaves.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ===== Admins (organizadores) =====
# SteamIDs que podem abrir o painel do organizador, separados por vírgula.
# O admin entra com a Steam (como qualquer jogador) e ganha o botão "Organizador".
# Ex.: VITE_ADMIN_STEAMIDS=765611...,765611...
VITE_ADMIN_STEAMIDS=

# ===== Steam Web API (SÓ no servidor — sem prefixo VITE_) =====
# Pegue uma chave em https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# ===== GSI (kills/dano automático do CS2) =====
# Token compartilhado: mesmo valor nos dois (função e .cfg do cliente).
GSI_TOKEN=mamometro-gsi
VITE_GSI_TOKEN=mamometro-gsi
# URL do Realtime Database onde a função GSI grava as pendências:
FIREBASE_DATABASE_URL=

# URL publica do site (o .cfg do GSI aponta pra ela; nao use localhost).
VITE_SITE_URL=https://seu-site.netlify.app

# ===== Pipeline de demos (VPS) — F0 =====
# URL do Realtime Database para o demo-parser gravar em matches/.
# Mesmo valor usado pela function do GSI acima (FIREBASE_DATABASE_URL).
FIREBASE_DATABASE_URL=

# Conta descartável do bot do cs-demo-downloader. NUNCA commite valores reais.
STEAM_BOT_USERNAME=REPLACE
STEAM_BOT_PASSWORD=REPLACE
STEAM_BOT_SHARED_SECRET=REPLACE_shared_secret_base64

# Mínimo de jogadores do roster presentes numa demo para ela ser salva.
# Abaixo disso a partida é descartada (e discardedByFilter++ no RTDB).
GROUP_MIN_MEMBERS=4
